{
  "manifest_version": 3,
  "name": "KYVON 0xPlus: Systems & Care Intelligence",
  "version": "1.0.0",
  "description": "⚡ Autonomous code auditing, 50-condition architecture verification, and real-time streaming AI diagnostics.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "KYVON 0xPlus",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "contextMenus",
    "tabs",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://ctoai.reiwasakura.tech/*"
  ]
}
